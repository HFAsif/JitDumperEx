<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <!--<supportedRuntime version="v4.0" />-->
  </startup>

  <runtime>
    <legacyCorruptedStateExceptionsPolicy enabled="true" />
    <loadFromRemoteSources enabled="true" />

    <!--
      Keep the application root clean while preserving standard .NET Framework
      assembly resolution. LoaderExDemo.exe.config must stay beside the EXE;
      all CopyLocal references are emitted under the private Dependencies folder below.
    -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="Dependencies" />
    </assemblyBinding>
  </runtime>
</configuration>
