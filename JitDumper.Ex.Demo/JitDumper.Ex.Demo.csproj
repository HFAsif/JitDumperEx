<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)_configs\LoaderExConfigs.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--<DefineConstants>$(DefineConstants);LOADEREX_VMP35_CFLOW</DefineConstants>-->

    <!--
      Standard .NET Framework probing requires LoaderExDemo.exe.config beside
      LoaderExDemo.exe. Everything else produced at the output root is routed
      below Dependencies\.
    -->
    <LoaderExDependenciesRelativePath>Dependencies\</LoaderExDependenciesRelativePath>
    <DotnetExVersion>4.1.60</DotnetExVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HFDotnetEx.Helpers" Version="$(DotnetExVersion)" />
    <PackageReference Include="DotnetEx.Microsoft.CSharp.Ex" Version="$(DotnetExVersion)" />
    <PackageReference Include="DotnetEx.Microsoft.Extensions.Logging.Abstractions.Ex" Version="$(DotnetExVersion)" />
    <PackageReference Include="DotnetEx.System.Reflection.Metadata.Ex" Version="$(DotnetExVersion)" />
    <PackageReference Include="DotnetEx.System.Runtime.CompilerServices.Unsafe.Ex" Version="$(DotnetExVersion)" />
    <PackageReference Include="DotnetEx.System.Runtime.Loader.Ex" Version="$(DotnetExVersion)" />
  </ItemGroup>

  <!--
    Remove output left by the superseded executable-name dependency layout.
    A Windows directory and the LoaderExDemo.exe file cannot share the same path.
    Also clear the old LoaderExDemo folder layout and this build's private dependency root so stale package assets cannot
    survive an incremental rebuild. This never deletes the executable file itself.
  -->
  <Target Name="LoaderExPreparePrivateDependencies"
          BeforeTargets="_CopyFilesMarkedCopyLocal">
    <RemoveDir Directories="$(TargetDir)$(TargetFileName)"
               Condition="$([System.IO.Directory]::Exists('$(TargetDir)$(TargetFileName)'))" />
    <RemoveDir Directories="$(TargetDir)$(MSBuildProjectName)"
               Condition="$([System.IO.Directory]::Exists('$(TargetDir)$(MSBuildProjectName)'))" />
    <RemoveDir Directories="$(TargetDir)$(LoaderExDependenciesRelativePath)"
               Condition="$([System.IO.Directory]::Exists('$(TargetDir)$(LoaderExDependenciesRelativePath)'))" />
    <MakeDir Directories="$(TargetDir)$(LoaderExDependenciesRelativePath)" />
  </Target>

  <!--
    Route every resolved CopyLocal reference directly into the private probing
    directory. Existing DestinationSubDirectory metadata is retained so
    satellite/runtime assets keep their own relative structure.
  -->
  <Target Name="LoaderExRouteCopyLocalReferences"
          BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Update="@(ReferenceCopyLocalPaths)">
        <DestinationSubDirectory>$(LoaderExDependenciesRelativePath)%(ReferenceCopyLocalPaths.DestinationSubDirectory)</DestinationSubDirectory>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>

  <!--
    Output hygiene fallback for common build/reference artifacts that can still be
    emitted at the root by the compiler or package targets. Directory globs are
    intentionally avoided so the Dependencies directory itself
    can never be mistaken for a file. The EXE and its required EXE.CONFIG remain.
  -->
  <Target Name="LoaderExCleanOutputRoot"
          AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_LoaderExRootArtifacts Include="$(TargetDir)*.dll;$(TargetDir)*.dll.config;$(TargetDir)*.pdb;$(TargetDir)*.xml;$(TargetDir)*.json" />
    </ItemGroup>

    <MakeDir Directories="$(TargetDir)$(LoaderExDependenciesRelativePath)"
             Condition="'@(_LoaderExRootArtifacts)' != ''" />

    <Copy SourceFiles="@(_LoaderExRootArtifacts)"
          DestinationFolder="$(TargetDir)$(LoaderExDependenciesRelativePath)"
          SkipUnchangedFiles="true"
          Condition="'@(_LoaderExRootArtifacts)' != ''" />

    <Delete Files="@(_LoaderExRootArtifacts)"
            Condition="'@(_LoaderExRootArtifacts)' != ''" />
  </Target>

</Project>
